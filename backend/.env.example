BROKER_MODE=mt5
MT5_SYMBOL=GOLD#
MT5_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe

AUTO_TRADE=true
MAX_LAYERS=1
FIXED_LOTS=0.02
SL_DOLLARS=2.5
TP_DOLLARS=5
# Stop opening new trades once today's P&L (UTC day) is this far down. Blank = 3 full stop-losses.
MAX_DAILY_LOSS_USD=

NEWS_WINDOW_BEFORE_MIN=30
NEWS_WINDOW_AFTER_MIN=30
DEAD_FILL_MIN=20
DEAD_FILL_R=0.15

# Calendar cuts (UTC). Weekdays Mon=0 .. Fri=4. Leave a value empty to trade through.
BLOCKED_SESSIONS=london
BLOCKED_WEEKDAYS=4
BLOCKED_HOURS_UTC=19

PORT=8001
