{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MIB Gold",
  "version": "0.1.0",
  "identifier": "com.mibgold.terminal",
  "build": {
    "beforeDevCommand": "cd ../frontend && yarn start",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "cd ../frontend && yarn build",
    "frontendDist": "../frontend/build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MIB Gold",
        "width": 1600,
        "height": 940,
        "minWidth": 1280,
        "minHeight": 760,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"]
  },
  "plugins": {
    "shell": { "open": false }
  }
}